{:description "Fallback default user configuration for MiniForge Core"
 :config
 ;; Keep in sync with resources/config/default-user-config.edn, which says
 ;; why there is no :llm :model and no :agents :default-models.
 {:llm {:backend :opencode}
  ;; No checkpoint or worktree root: both derive from MINIFORGE_HOME (see
  ;; resources/config/default-user-config.edn).
  :model-selection {:enabled true
                    :strategy :automatic
                    :cost-limit-per-task 0.10
                    :prefer-speed false
                    :allow-downgrade true
                    :require-local false}
  :self-healing {:enabled true
                 :workaround-auto-apply true
                 :backend-auto-switch true
                 :backend-health-threshold 0.90
                 :backend-switch-cooldown-ms 1800000
                 :allowed-failover-backends [:opencode]
                 :max-cost-per-workflow nil}
  :dashboard {:port 7878
              :auto-open false}}}
