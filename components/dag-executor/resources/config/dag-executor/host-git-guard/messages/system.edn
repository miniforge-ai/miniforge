{:dag-executor.host-git-guard/system
 {;; snapshot — `git config --get-regexp` could not be read
  :snapshot/remote-urls-failed
  "Could not read redirect config from the host checkout"

  ;; snapshot — `git rev-parse --git-common-dir` could not be read
  :snapshot/common-dir-failed
  "Could not resolve the git common dir of the host checkout"

  ;; snapshot — `git for-each-ref refs/remotes/` could not be read
  :snapshot/remote-refs-failed
  "Could not read remote-tracking refs from the host checkout"

  ;; drift — a remote URL or insteadOf rewrite differs between the before
  ;; and after snapshots
  :drift/remote-url-changed
  "A task run changed where the host checkout pushes and fetches"

  ;; drift — a remote-tracking ref moved to a commit that is not a
  ;; descendant of where it started; reported as context, never on its own
  :drift/remote-ref-rewound
  "A remote-tracking ref moved off its own history"

  ;; drift — the ancestry probe itself failed, so containment is unknown
  :drift/ancestry-unknown
  "Could not determine whether a remote-tracking ref moved forward"

  ;; guarded executor — acquiring against a checkout an earlier run drifted
  :guard/host-drifted-before-acquire
  "Acquiring a task worktree of a checkout an earlier run already drifted"

  ;; guarded executor — the post-release check found drift
  :guard/host-drifted-during-run
  "A task run changed where the host checkout pushes and fetches"

  ;; guarded executor — the post-release snapshot could not be read, so
  ;; whether the run drifted the checkout is unknown
  :guard/post-release-snapshot-failed
  "Could not re-read the host checkout after a task run; drift is unknown"}}
