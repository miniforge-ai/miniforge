{:namespace "default"
 :image "alpine:latest"
 :kubernetes/pod-ready-timeout-ms 120000
 :kubernetes/pod-ready-poll-interval-ms 2000
 :kubernetes/executable "kubectl"
 :kubernetes/workdir "/workspace"
 :kubernetes/resources {:limits {:memory "512Mi"
                                 :cpu "500m"}
                        :requests {:memory "256Mi"
                                   :cpu "100m"}}}
