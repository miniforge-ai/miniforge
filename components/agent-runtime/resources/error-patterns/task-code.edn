;; Audit note (2026-06-12): reviewed for failure-class divergence.
;; All 8 patterns are user-code errors (syntax, compilation, linting, test failures,
;; namespace resolution, file-not-found, parse errors) that correctly map to
;; :failure.class/task-code via the file-level :type fallback.
;; No compilation-timeout or test-runner-stall entries present.
;; No :failure/class annotations required on current entries.
{:description "Patterns that indicate user code errors"
 :type :task-code
 :vendor "miniforge"
 :patterns
 [{:regex "Syntax error"
   :description "Syntax error in code"}
  {:regex "Compilation failed"
   :description "Compilation failure"}
  {:regex "linting took.*errors:"
   :description "Linting errors"}
  {:regex "test suite failed"
   :description "Test failures"}
  {:regex "Could not resolve namespace"
   :description "Namespace resolution error"}
  {:regex "No such file or directory"
   :description "File not found"}
  {:regex "Unexpected token"
   :description "Unexpected token in code"}
  {:regex "Parse error"
   :description "Parse error"}]}
