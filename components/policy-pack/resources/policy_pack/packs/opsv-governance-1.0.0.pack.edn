;; OPSV Governance Policy Pack — canonical seven-phase lifecycle gates.
;; Reference: N4 Policy Packs & Gates Standard §2.2, §2.3
;; Dewey category: 500 (Operations & Infrastructure)

{:pack/id          "miniforge/opsv-governance"
 :pack/name        "OPSV Governance"
 :pack/version     "1.0.0"
 :pack/description "Discover-Plan-Execute-Converge-Synthesize-Verify-Actuate governance for instrumentation, environment, blast radius, abort, actuation, and evidence."
 :pack/author      "miniforge.ai"
 :pack/license     "Apache-2.0"
 :pack/trust-level :trusted
 :pack/authority   :authority/instruction
 :pack/taxonomy-ref {:taxonomy/id :miniforge/dewey :taxonomy/min-version "1.0.0"}

 :pack/categories
 [{:category/id   "500"
   :category/name "OPSV Governance"
   :category/rules [:opsv/instrumentation-gate
                    :opsv/environment-gate
                    :opsv/blast-radius-gate
                    :opsv/abort-gate
                    :opsv/actuation-gate
                    :opsv/evidence-completeness-gate]}]

 :pack/rules
 [{:rule/id          :opsv/instrumentation-gate
   :rule/title       "Instrumentation Gate"
   :rule/description "Validates that the target environment has adequate observability instrumentation (metrics, logs, traces) before any change is applied. Changes to unmonitored environments are blocked."
   :rule/severity    :critical
   :rule/category    "500"
   :rule/applies-to  {:phases #{:discover :execute}}
   :rule/detection   {:type :custom
                      :custom-fn ai.miniforge.gate.opsv/instrumentation-detector}
   :rule/enforcement {:action :hard-halt
                      :message "Target environment lacks required instrumentation. Deploy observability infrastructure before applying changes."
                      :remediation "Ensure metrics, logging, and tracing are configured and healthy in the target environment."}}

  {:rule/id          :opsv/environment-gate
   :rule/title       "Environment Gate"
   :rule/description "Requires target environments to be allowed, inside configured time windows, and explicitly allowlisted when production is targeted."
   :rule/severity    :critical
   :rule/category    "500"
   :rule/applies-to  {:phases #{:plan :execute}}
   :rule/detection   {:type :custom
                      :custom-fn ai.miniforge.gate.opsv/environment-detector}
   :rule/enforcement {:action :hard-halt
                      :message "Target environment or execution window is not authorized."
                      :remediation "Select an allowed environment and time window; obtain explicit allowlisting for production."}}

  {:rule/id          :opsv/blast-radius-gate
   :rule/title       "Blast Radius Gate"
   :rule/description "Enforces configured maximum replica delta, node delta, and namespace scope for an experiment."
   :rule/severity    :critical
   :rule/category    "500"
   :rule/applies-to  {:phases #{:plan :execute}}
   :rule/detection   {:type :custom
                      :custom-fn ai.miniforge.gate.opsv/blast-radius-detector}
   :rule/enforcement {:action :hard-halt
                      :message "Proposed replica, node, or namespace scope exceeds policy."
                      :remediation "Reduce the experiment to the configured replica, node, and namespace limits."}}

  {:rule/id          :opsv/abort-gate
   :rule/title       "Abort Condition Gate"
   :rule/description "Requires error-budget burn, saturation, and tail-latency abort thresholds before experiment execution."
   :rule/severity    :critical
   :rule/category    "500"
   :rule/applies-to  {:phases #{:plan :execute}}
   :rule/detection   {:type :custom
                      :custom-fn ai.miniforge.gate.opsv/abort-detector}
   :rule/enforcement {:action :hard-halt
                      :message "Experiment is missing one or more required abort thresholds."
                      :remediation "Configure error-budget burn, saturation, and tail-latency rollback triggers."}}

  {:rule/id          :opsv/actuation-gate
   :rule/title       "Actuation Authorization Gate"
   :rule/description "Keeps APPLY_ALLOWED disabled by default and requires explicit enablement plus a per-service allowlist."
   :rule/severity    :critical
   :rule/category    "500"
   :rule/applies-to  {:phases #{:actuate}}
   :rule/detection   {:type :custom
                      :custom-fn ai.miniforge.gate.opsv/actuation-detector}
   :rule/enforcement {:action :hard-halt
                      :message "APPLY_ALLOWED is not explicitly authorized for every target service."
                      :remediation "Enable apply in policy and allowlist every target service, or use a safer actuation mode."}}

  {:rule/id          :opsv/evidence-completeness-gate
   :rule/title       "Evidence Completeness"
   :rule/description "Requires the Experiment Pack hash, environment fingerprint, and metric snapshots before actuation."
   :rule/severity    :high
   :rule/category    "500"
   :rule/applies-to  {:phases #{:verify :actuate}}
   :rule/detection   {:type :custom
                      :custom-fn ai.miniforge.gate.opsv/evidence-completeness-detector}
   :rule/enforcement {:action :hard-halt
                      :message "OPSV evidence is missing required actuation inputs."
                      :remediation "Attach the Experiment Pack hash, environment fingerprint, and metric snapshots."}}]

 :pack/created-at #inst "2026-04-08T00:00:00Z"
 :pack/updated-at #inst "2026-08-05T00:00:00Z"}
