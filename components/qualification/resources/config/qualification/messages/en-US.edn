{:qualification/messages
 {;; Rows (verdict.clj)
  :criterion/no-result      "Not run: the scenario reported no result for this criterion"
  :criterion/scenario-threw "Not run: the scenario threw {type}: {message}"
  :criterion/scenario-invalid "Not run: the scenario's output was invalid: {problems}"
  :result/undeclared        "result for criterion {id}, which the gate does not declare"
  :result/duplicate         "more than one result for criterion {id}"

  ;; Summary (run.clj)
  :summary/verdict          "Qualification {gate}: {verdict}, {passed} of {total} criteria passed"
  :summary/row              "  {status} {id}: {description}"
  :summary/wrote            "Report written: {path}"
  :summary/write-failed     "The report could not be written: {message}"}}
