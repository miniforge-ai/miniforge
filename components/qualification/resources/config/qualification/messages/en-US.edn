{:qualification/messages
 {;; Rows (verdict.clj)
  :criterion/no-result      "Not run: the scenario reported no result for this criterion"
  :criterion/scenario-threw "Not run: the scenario threw {type}: {message}"
  :criterion/scenario-invalid "Not run: the scenario's output was invalid: {problems}"
  :result/undeclared        "result for criterion {id}, which the gate does not declare"
  :result/duplicate         "more than one result for criterion {id}"
  :scenario/not-plain-data  "fixtures, config and results must be plain EDN data that reads back from its hashed form, so hashes repeat and the report can be written"

  ;; Write refusals (writer.clj)
  :write/path-leaves-out-dir        "report path leaves the output directory"
  :write/json-key-collision         "two keys in one map would write the same JSON property"
  :write/directory-resolves-outside "report directory resolves outside the output directory"
  :write/edn-does-not-read-back     "the report's EDN would not read back as the report"

  ;; Summary (run.clj)
  :summary/verdict          "Qualification {gate}: {verdict}, {passed} of {total} criteria passed"
  :summary/unpinned         "  Every criterion passed, but the build is not a clean, identified commit, so the verdict is incomplete"
  :summary/row              "  {status} {id}: {description}"
  :summary/wrote            "Report written: {path}"
  :summary/write-failed     "The report could not be written: {message}"
  :summary/invalid-gate     "Not a valid gate definition: {problems}"
  :summary/invalid-report   "The run produced no valid report, so nothing was written: {problems}"}}
