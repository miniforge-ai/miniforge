{;; The Claude CLI's --max-budget-usd when a request sets :max-tokens and no
 ;; :budget-usd. It must clear the CLI's own fixed cost per call: the
 ;; Claude Code system prompt and prompt-cache writes cost about
 ;; $0.09-0.14 before the caller's tokens. At $0.10 ordinary single-turn
 ;; calls ran over, the CLI exited 1, and complete answers came back as
 ;; failures. :max-tokens is not forwarded to the CLI (it has no output-token
 ;; flag); it only switches this default on. The CLI's own reply limit and
 ;; --max-turns bound a call; this dollar cap is the only spend guard.
 :claude-cli
 {:default-budget-usd "1.00"}

 ;; Direct HTTPS provider backends (:anthropic-api / :openai-api /
 ;; :gemini-api). Only Anthropic's Messages API REQUIRES max_tokens on
 ;; every request, so only it carries a default here — OpenAI and
 ;; Gemini omit the cap unless the caller sets :max-tokens.
 :http
 {;; A direct provider call is non-streaming: nothing arrives until the
  ;; model finishes. Sized like the stream ceiling below so a long
  ;; completion is not cut at http-kit's 60 s default.
  :idle-timeout-ms 600000
  :anthropic {:api-version "2023-06-01"
              :default-max-tokens 16000}
  ;; Sent as the `provider` object of every OpenRouter request, in
  ;; OpenRouter's own field names. OpenRouter serves one model from
  ;; several hosts with different data policies, and it treats two of
  ;; them separately: "deny" excludes hosts that may train on prompts,
  ;; and `:zdr true` limits routing to zero-data-retention endpoints,
  ;; which store nothing (a host can retain without training, for
  ;; abuse scanning). A model with no such endpoint fails the call
  ;; instead of falling back to a host that keeps the prompt.
  :openrouter {:provider {:data_collection "deny"
                          :zdr true}}}

 ;; Framework defaults for a monitored streaming run. A role overrides
 ;; them per turn through its prompt config's :prompt/progress-monitor
 ;; block (components/agent/resources/prompts/{planner,reviewer,implementer}.edn);
 ;; the implementer carries a 30-minute :max-total-ms because its turns
 ;; write many files (2026-09-04 trap-bench series 9 cut two of them at
 ;; this 10-minute default).
 :stream
 {:default-stagnation-threshold-ms 120000
  :default-max-total-ms 600000
  :default-min-activity-interval-ms 5000
  ;; Hard "no stdout line at all" timeout. Distinct from stagnation:
  ;; stagnation tracks meaningful progress (parsed events that refresh
  ;; activity), while line-timeout fires whenever stdout is empty for
  ;; this long regardless of what the parser would have done with the
  ;; line. Opus on a 100k-token first-turn prompt empirically goes
  ;; silent on stdout for 180-300s after the initial system+rate_limit
  ;; pair (next line is the first assistant chunk). 180s used to fire
  ;; before the model could emit anything (event-log-tool-visibility
  ;; dogfood, 2026-05-04). The 2026-06-06 review-redirect-convergence
  ;; dogfood (`adhoc-2073513324`) hit 360s on the reviewer's larger
  ;; prompt — full review.clj + tests + spec + standards pack — and
  ;; killed the call before any verdict landed. Raised to 420s to give
  ;; the reviewer's longer first turn the same margin the implementer
  ;; relies on; the watchdog backstop floats up alongside it (see
  ;; `default-gap-threshold-ms` in components/agent/src/ai/miniforge/agent/stream_watchdog.clj).

  :line-timeout-ms 420000
  :process-join-timeout-ms 600000
  :post-kill-join-timeout-ms 5000
  :poll-interval-ms 250}

 ;; The environment an agent CLI process (claude, codex, cursor-agent,
 ;; opencode) gets: only these variables from miniforge's own environment.
 ;; The CLI passes its environment on to the commands its tools run, so
 ;; anything else (GH_TOKEN, GITHUB_TOKEN, AWS_* credentials,
 ;; SSH_AUTH_SOCK, miniforge's own tokens such as MINIFORGE_GIT_TOKEN)
 ;; stays out of the agent's reach. A name matching :deny-prefixes is
 ;; dropped even when an allow entry matches it.
 :agent-env
 {:allow ["PATH" "HOME" "USER" "LOGNAME" "SHELL" "TMPDIR" "TZ"
          "LANG" "LANGUAGE" "TERM" "COLORTERM"
          ;; Proxies and TLS trust, so the CLI reaches its provider.
          "HTTP_PROXY" "HTTPS_PROXY" "NO_PROXY" "ALL_PROXY"
          "http_proxy" "https_proxy" "no_proxy" "all_proxy"
          "SSL_CERT_FILE" "SSL_CERT_DIR" "NODE_EXTRA_CA_CERTS"
          "REQUESTS_CA_BUNDLE" "CURL_CA_BUNDLE"
          ;; Provider keys and config the agent CLIs read.
          "CODEX_HOME" "CURSOR_API_KEY" "GOOGLE_API_KEY"
          ;; Read by the hook and the context server the CLI starts.
          "MINIFORGE_HOME" "MINIFORGE_CODEX_PATH" "MINIFORGE_LOCALE"
          "JAVA_HOME"]
  :allow-prefixes ["LC_" "XDG_" "ANTHROPIC_" "CLAUDE_" "OPENAI_"
                   "OPENROUTER_" "GEMINI_" "OPENCODE_"]
  :deny-prefixes ["AWS_" "GH_" "GITHUB_"]}}
