;; Pure-data fields of each LLM backend, keyed by backend keyword.
;; The function-valued fields (:stream-parser, :args-fn) stay in
;; llm_client.clj and are merged onto these maps at load time. See the
;; `backends` var there for the merge and for the rationale of each
;; field (prompt delivery, probe endpoints, credential handling).
;;
;; :probe-endpoint-routes point the network-drop probe at the endpoint
;; the CLI is configured to use (llm-client/probe-endpoint-for). The
;; first route that applies decides: a route with :when-env applies
;; only when that switch is set and not off. It yields the URL in
;; :base-url-env, else :global-url or :regional-url (%s = region) for
;; the region in :region-env; when it yields nothing the static
;; :probe-endpoint is used. Bedrock and Vertex come first because the
;; Claude CLI does not use ANTHROPIC_BASE_URL when either is on.
;;
;; :credential-env names the env vars a CLI backend reads its credential
;; from, which a default-trust task capsule keeps for the agent (see
;; `backend-credential-env` in the llm interface).
;;
;; :catalog-backend names the model-catalog backend whose models a
;; single-provider backend serves (the Anthropic API serves the catalog's
;; :claude models). A backend without one routes to many providers and
;; takes any model. See llm.interface/backend-serves-model?.
{:claude {:cmd "claude"
          :streaming? true
          :description "Claude via Anthropic CLI"
          :provider "Anthropic"
          :requires-cli? true
          :credential-env ["ANTHROPIC_API_KEY"]
          :catalog-backend :claude
          ;; Prompt delivery: stdin. The planner path's system-prompt +
          ;; spec text + existing-files context regularly pushes argv
          ;; past POSIX ARG_MAX. Claude CLI supports --input-format text
          ;; to read the user prompt from stdin; we use that instead.
          :prompt-via :stdin
          :probe-endpoint "https://api.anthropic.com/"
          :probe-endpoint-routes
          [{:when-env "CLAUDE_CODE_USE_BEDROCK"
            :base-url-env "ANTHROPIC_BEDROCK_BASE_URL"
            :region-env "AWS_REGION"
            :regional-url "https://bedrock-runtime.%s.amazonaws.com/"}
           {:when-env "CLAUDE_CODE_USE_VERTEX"
            :base-url-env "ANTHROPIC_VERTEX_BASE_URL"
            :region-env "CLOUD_ML_REGION"
            :global-url "https://aiplatform.googleapis.com/"
            :regional-url "https://%s-aiplatform.googleapis.com/"}
           {:base-url-env "ANTHROPIC_BASE_URL"}]}

 :codex {:cmd "codex"
         :streaming? true
         :description "Codex via Codex CLI"
         :provider "Codex"
         :requires-cli? true
         :credential-env ["OPENAI_API_KEY"]
         :catalog-backend :codex
         ;; Prompt delivery: stdin. Codex supports `-` as the prompt
         ;; placeholder; this keeps large synthesis prompts off argv.
         :prompt-via :stdin
         :probe-endpoint "https://api.openai.com/"
         :probe-endpoint-routes [{:base-url-env "OPENAI_BASE_URL"}]}

 :ollama {:cmd "http"
          :streaming? true
          :description "Local models via Ollama"
          :provider "Ollama"
          :requires-cli? false
          :catalog-backend :ollama
          :api-endpoint "http://localhost:11434/api/chat"
          :default-model "codellama"
          :models ["codellama" "llama2" "mistral"]
          :probe-endpoint "http://localhost:11434/api/version"}

 ;; Direct API-key HTTPS providers — for builds where CLI-agent
 ;; backends are unavailable (a sandboxed child process inherits the
 ;; sandbox, so the user's claude/codex CLI cannot run). :api-key-env
 ;; names the environment variable consulted when the client config
 ;; carries no :api-key.
 :anthropic-api {:cmd "http"
                 :streaming? false
                 :description "Claude via Anthropic Messages API"
                 :provider "Anthropic"
                 :requires-cli? false
                 :catalog-backend :claude
                 :api-endpoint "https://api.anthropic.com/v1/messages"
                 :api-key-env "ANTHROPIC_API_KEY"
                 :probe-endpoint "https://api.anthropic.com/"}

 :openai-api {:cmd "http"
              :streaming? false
              :description "GPT via OpenAI Chat Completions API"
              :provider "OpenAI"
              :requires-cli? false
              :catalog-backend :codex
              :api-endpoint "https://api.openai.com/v1/chat/completions"
              :api-key-env "OPENAI_API_KEY"
              :probe-endpoint "https://api.openai.com/"}

 ;; Any OpenAI-compatible /v1/chat/completions endpoint: local keyless
 ;; servers (LM Studio, llama.cpp, vLLM) AND keyed aggregators
 ;; (OpenRouter, a hosted OpenAI/Together key). :optional-api-key? true
 ;; means a key is SENT when resolved (client :api-key, else the env var)
 ;; but is NOT required — so a local keyless server and a keyed OpenRouter
 ;; host both work through this one backend, and the endpoint (LM Studio
 ;; default) is overridable per client via :base-url or :base-url-env.
 ;; For OpenRouter, set
 ;; MINIFORGE_OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1/chat/completions
 ;; and MINIFORGE_OPENAI_COMPAT_API_KEY=<key>.
 :openai-compat {:cmd "http"
                 :streaming? false
                 :description "Any OpenAI-compatible server (LM Studio, llama.cpp, vLLM, OpenRouter, ...)"
                 :provider "OpenAI-Compatible"
                 :requires-cli? false
                 :api-endpoint "http://localhost:1234/v1/chat/completions"
                 :base-url-env "MINIFORGE_OPENAI_COMPAT_BASE_URL"
                 :api-key-env "MINIFORGE_OPENAI_COMPAT_API_KEY"
                 :optional-api-key? true
                 :probe-endpoint "http://localhost:1234/v1/models"}

 ;; OpenRouter: one key, many upstream providers, over the OpenAI wire
 ;; shape. Model ids are OpenRouter's (`vendor/model`). The response
 ;; reports billed cost and cached-token counts, which the client keeps.
 :openrouter {:cmd "http"
              :streaming? false
              :description "Any hosted model via OpenRouter (one API key)"
              :provider "OpenRouter"
              :requires-cli? false
              :api-endpoint "https://openrouter.ai/api/v1/chat/completions"
              :api-key-env "OPENROUTER_API_KEY"
              :probe-endpoint "https://openrouter.ai/api/v1/models"}

 ;; Gemini's REST shape embeds the model in the URL path, so
 ;; :api-endpoint is a format string filled by `request-endpoint`
 ;; (:model-in-url?).
 :gemini-api {:cmd "http"
              :streaming? false
              :description "Gemini via Google Generative Language API"
              :provider "Gemini"
              :requires-cli? false
              :catalog-backend :gemini-api
              :api-endpoint "https://generativelanguage.googleapis.com/v1beta/models/%s:generateContent"
              :model-in-url? true
              :api-key-env "GEMINI_API_KEY"
              :probe-endpoint "https://generativelanguage.googleapis.com/"}

 :cursor {:cmd "agent"
          :streaming? false
          :description "Cursor AI via CLI"
          :provider "Cursor"
          :requires-cli? true
          :credential-env ["CURSOR_API_KEY"]
          :prompt-via :argv
          :probe-endpoint "https://api2.cursor.sh/"}

 :opencode {:cmd "opencode"
            :streaming? false
            :description "OpenCode CLI provider wrapper"
            :provider "OpenCode"
            :requires-cli? true
            :credential-env ["ANTHROPIC_API_KEY" "OPENAI_API_KEY"]
            :prompt-via :argv
            ;; OpenCode's typical default provider; tunable per-deployment.
            :probe-endpoint "https://api.anthropic.com/"}

 ;; :echo's :probe-endpoint mirrors the in-code
 ;; `generic-connectivity-probe-url` ("https://1.1.1.1/"): backends
 ;; without a provider-controlled endpoint get the generic Cloudflare
 ;; DNS connectivity URL so the network-monitor still has something to
 ;; probe.
 :echo {:cmd "echo"
        :streaming? false
        :description "Echo backend for testing"
        :provider "Test"
        :requires-cli? false
        :prompt-via :argv
        :probe-endpoint "https://1.1.1.1/"}}
