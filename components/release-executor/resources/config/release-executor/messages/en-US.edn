{:release-executor/messages
 {;; defaults
  :default/change "change"
  :default/task-description "implement changes"

  ;; logs
  :releaser/failed-fallback "Releaser agent failed, using fallback"
  :release/using-deterministic-metadata
  "No releaser agent or LLM available, using deterministic metadata"

  ;; validation
  :exec/missing-worktree-path "Context must include :worktree-path for release phase"
  :exec/missing-executor "Context must include :executor for release phase"
  :exec/missing-environment-id "Context must include :environment-id for release phase"

  ;; gh auth
  :gh/auth-login-hint "Run: gh auth login"
  :gh/install-hint "Install: brew install gh"

  ;; pr creation
  :pr/create-unconfirmed "gh pr create reported success but printed no PR URL — cannot confirm a PR was opened (output: {output})"
  :pr/reuse-unresolved "A PR already exists for this branch but could not be resolved via gh pr view: {error}"
  :pr/reuse-no-url "gh pr view returned no PR URL"
  :pr/closed "Branch {branch} already has a closed PR ({pr-url}); not opening another"
  :pr/merged-other "Branch {branch} already has a merged PR ({pr-url}) of another commit; this release's commit is in no PR"
  :pr/lookup-failed "Could not check whether branch {branch} already has a PR: {error}"

  ;; push and PR creation recorded as effect transactions
  :push/unresolved "Whether branch {branch} was pushed is unknown and the remote could not confirm it: {detail}"
  :push/no-commit "No release commit to push on branch {branch}"
  :pr/unresolved "Whether a PR was opened for branch {branch} is unknown and GitHub could not confirm it: {detail}"
  :pr/recorded-not-found "A PR for branch {branch} is recorded as opened, but GitHub lists none"

  ;; release branch
  :branch/diverged "Release branch {branch} already exists and does not contain HEAD; not reusing it"

  ;; publish after prepare
  :publish/worktree-moved "The worktree moved after the release was prepared: expected {branch} at {commit-sha}, found {head-branch} at {head-sha}; not publishing"

  ;; push HTTPS+token fallback (host mode): why no credential was sent
  :push/token-retry-skipped
  "The HTTPS token retry was not attempted and no credential was sent: {reason}."
  :push/token-retry-not-single-target
  "origin has more than one push URL (a mirror or several url/pushurl entries)"
  :push/token-retry-rewritten
  "git rewrites origin's push URL (insteadOf or pushInsteadOf), so the destination is not the configured URL"
  :push/token-retry-untrusted-host
  "origin's push URL is not on github.com, the only host the token is sent to"
  :push/token-retry-env-config
  "the environment already sets GIT_CONFIG_COUNT or GIT_CONFIG_PARAMETERS, so the retry could not run under the config that was checked"

  ;; push HTTPS+token fallback
  :push/https-fallback-setup-failed
  "Push failed and the HTTPS token fallback could not be applied: repointing origin to the token URL failed, so origin is unchanged (no token persisted). Push error: {push-error}. Set-url error: {set-url-error}"
  :push/https-fallback-restore-failed
  "Pushed via HTTPS token fallback but could not restore the origin remote URL; it may still embed the GitHub token. Scrub it: git remote set-url origin {remote-url}. Restore error: {restore-error}"
  :push/https-fallback-push-and-restore-failed
  "HTTPS token-fallback push failed and the origin remote URL could not be restored; it may still embed the GitHub token. Scrub it: git remote set-url origin {remote-url}. Push error: {push-error}. Restore error: {restore-error}"

  ;; bounded remote calls (fetch, push, gh)
  :shell/timed-out
  "{command} did not finish within {timeout-ms} ms; it and its child processes were killed. A stalled connection or a credential prompt can cause this."

  ;; pipeline steps
  :step/metadata-generation-failed "Releaser agent failed to generate release metadata"
  :step/no-files-to-stage "No modified files in executor environment to stage for release"
  :step/diff-stats-unavailable
  "Diff statistics unavailable for safety-gate validation; refusing to proceed"
  :step/diff-net-negative-tests
  "Diff removes more tests than it adds ({removed} removed, {added} added)"
  :step/diff-heavily-destructive
  "Diff is heavily destructive ({deletions} deletions vs {additions} additions)"

  ;; release metadata
  :pr/summary-section "## Summary\n\n{summary}\n\n"
  :pr/changes-section "## Changes\n\n{file-list}\n\n"
  :pr/test-plan-section
  "## Test plan\n\n- [ ] Verify changes compile and tests pass\n- [ ] Review generated code for correctness\n\n"
  :pr/review-section "## Review\n\n{review-body}\n\n"
  :pr/decision "**Decision**: {decision}"
  :pr/known-issues-header "### Known issues (non-blocking)\n\nMerged with {count} unresolved non-blocking issue(s) recorded for follow-up:\n\n"
  :pr/known-issue-item "- {item}"
  :pr/gate-results-section "{gate-body}"
  :pr/footer "---\nGenerated by Miniforge SDLC workflow ({file-count} {file-label})"
  :pr/file-singular "file"
  :pr/file-plural "files"}}