{:spec/title "Dogfood OPSV on agent invocation and phase budgets"

 :spec/description
 "Use the completed OPSV workflow as a second use case for agent budgets.
  Build observations from backend-reported input, output, and cache token usage;
  stop reason; turns; tool-call count; and phase iterations. Run a pinned fixture
  experiment, verify a candidate policy, and emit a dry-run configuration diff.
  Character length and :max-tokens are context only, never token measurements or
  a backend-independent output cap."

 :spec/intent
 {:type :performance
  :scope ["components/agent/src/**"
          "components/phase/src/**"
          "components/event-stream/src/**"
          "components/opsv-adapter-agent-budget/**"
          "resources/opsv/agent-budgets-experiment.edn"]}

 :normative-refs
 ["specs/normative/N3-event-stream.md"
  "specs/normative/N6-evidence-provenance.md"
  "specs/normative/N7-Operational-Policy-Synthesis.md"]

 :spec/constraints
 ["Usage MUST come from the backend response and preserve input/output/cache dimensions"
  "Empty output MUST retain its typed stop reason or failure class"
  "Fixtures, model identifiers, adapter versions, and inputs MUST be pinned"
  "Actuation MUST default to a dry-run diff and require the normal OPSV authority path"]

 :spec/acceptance-criteria
 ["Every measured invocation records backend usage, stop reason, turns, and tool-call count"
  "Context overflow is classified from backend evidence rather than character-length heuristics"
  "The pinned fixture experiment terminates within its declared trial and iteration budgets"
  "Verification rejects candidates with silent empty output or failed artifact submission"
  "The dry run emits a versioned configuration diff with experiment and evidence identifiers"]

 :spec/priority
 {:tier :high
  :axes #{:dogfood-enabler :token-conservation :observation :correctness}
  :theme :operational-policy-synthesis
  :rationale "This validates OPSV on a second numeric-control domain after the HPA/KEDA MCI."
  :blocks []
  :blocked-by ["n07-opsv-cli-tui-drift.spec.edn"]}

 :dag/id :n07-opsv-agent-budgets
 :spec/workflow-type :canonical-sdlc}
