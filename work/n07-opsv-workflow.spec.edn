{:spec/title "Implement the seven-phase OPSV workflow and staging MCI"

 :spec/description
 "Register an :opsv workflow that executes DISCOVER, PLAN, EXECUTE,
  CONVERGE, SYNTHESIZE, VERIFY, and ACTUATE through the shared N2 phase
  lifecycle. Supply simulated observability and load adapters so an integration
  fixture discovers CPU plus backlog signals, runs guarded ramp steps, and
  synthesizes an HPA/KEDA-compatible proposal without external mutation."

 :spec/intent
 {:type :feature
  :scope ["components/phase-opsv/**"
          "components/workflow-opsv/**"
          "components/opsv-adapter-simulated/**"
          "projects/miniforge/deps.edn"]}

 :normative-refs
 ["specs/normative/N2-workflows.md"
  "specs/normative/N3-event-stream.md"
  "specs/normative/N7-Operational-Policy-Synthesis.md"]

 :spec/constraints
 ["All seven phases MUST use the shared phase registry and workflow runner"
  "The staging MCI MUST be deterministic and require no live infrastructure"
  "ACTUATE MUST receive the verified proposal and effective actuation decision"
  "The default effective mode MUST remain :recommend-only"]

 :spec/acceptance-criteria
 ["Loading :opsv version 1.0.0 returns the exact seven-phase pipeline followed by :done"
  "Each OPSV phase emits shared phase lifecycle telemetry and its required N3 OPSV event"
  "The simulated staging run discovers both CPU and backlog candidate drivers"
  "The simulated staging run emits an HPA/KEDA-compatible Operational Policy Proposal"
  "The simulated staging run completes with effective mode :recommend-only and zero external effects"]

 :spec/priority
 {:tier :blocker
  :axes #{:dogfood-enabler :correctness :scale}
  :theme :operational-policy-synthesis
  :rationale "The complete shared-lifecycle MCI is the first executable proof of N7 conformance."
  :blocks ["n07-opsv-governed-actuation.spec.edn"
           "n07-opsv-cli-tui-drift.spec.edn"]
  :blocked-by ["n07-opsv-domain-policy.spec.edn"]}

 :dag/id :n07-opsv-workflow
 :spec/workflow-type :canonical-sdlc}
