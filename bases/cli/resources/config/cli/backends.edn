{:backend/defaults
 {:current :opencode}

 :backend/specs
 {:opencode
  {:provider "OpenCode"
   :description "OpenCode CLI provider/auth wrapper"
   :command "opencode"
   :installation "npm install -g opencode-ai"
   :models ["anthropic/claude-sonnet-4-5" "anthropic/claude-sonnet-4-6" "openai/gpt-5.2"]
   :check-type :cli
   :docs-url "https://opencode.ai/docs"}

  :claude
  {:provider "Anthropic"
   :description "Claude via Anthropic CLI"
   :command "claude"
   :installation "npm install -g @anthropic-ai/claude-cli"
   :models ["claude-sonnet-4-6" "claude-opus-4-7" "claude-opus-4-6" "claude-sonnet-4-5-20250929" "claude-haiku-4-5-20251001"]
   :check-type :cli}

  :codex
  {:provider "Codex"
   :description "Codex via Codex CLI"
   :command "codex"
   :installation "Install from https://codex.dev"
   :models ["gpt-5.3-codex" "gpt-5.2-codex" "gpt-5.2" "gpt-5.1-codex-max"]
   :check-type :cli
   :docs-url "https://codex.dev"}

  :cursor
  {:provider "Cursor"
   :description "Cursor AI via CLI"
   :command "agent"
   :installation "Install from https://cursor.sh"
   :models ["cursor-default"]
   :check-type :cli
   :docs-url "https://cursor.sh"}

  :ollama
  {:provider "Ollama"
   :description "Local models via Ollama"
   :command "ollama"
   :installation "brew install ollama"
   :models ["codellama" "llama2" "mistral"]
   :check-type :cli
   :docs-url "https://ollama.ai"}

  :echo
  {:provider "Test"
   :description "Echo backend for testing (no actual LLM)"
   :command "echo"
   :installation "Built-in"
   :models ["echo"]
   :check-type :builtin}}}
