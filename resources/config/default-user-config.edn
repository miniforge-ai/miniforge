{:description "Default user configuration for MiniForge Core"
 :config
 ;; OpenCode is the default provider/auth wrapper for agent runs. Provider
 ;; credentials live in OpenCode auth/config, not in miniforge environment
 ;; variables.
 ;;
 ;; No :llm :model and no :agents :default-models here: a model in the
 ;; defaults would reach every backend, and an anthropic/ id is valid only
 ;; on opencode. Each role's model follows the backend instead (see
 ;; ai.miniforge.agent.model/default-model-for-role); setting either key in
 ;; ~/.miniforge/config.edn overrides that.
 {:llm {:backend :opencode}
  ;; No [:workflow :checkpoint-root] and no :workflow/worktree-root here:
  ;; both default to <miniforge-home>/checkpoints and
  ;; <miniforge-home>/worktrees, so MINIFORGE_HOME moves them. A default
  ;; naming ~/.miniforge would win over MINIFORGE_HOME and send checkpoint
  ;; GC to the real home. Set either key in config.edn to choose another
  ;; place (for example "/tmp/miniforge-worktrees" for ephemeral CI runs).
  :model-selection {:enabled true
                    :strategy :automatic
                    :cost-limit-per-task 0.10
                    :prefer-speed false
                    :allow-downgrade true
                    :require-local false}
  :self-healing {:enabled true
                 :workaround-auto-apply true
                 :backend-auto-switch true
                 :backend-health-threshold 0.90
                 :backend-switch-cooldown-ms 1800000
                 :allowed-failover-backends [:opencode]
                 :max-cost-per-workflow nil
                 ;; Agent output-stream gap threshold. If no output line is received
                 ;; from the backend process for this many milliseconds, a
                 ;; :agent/stream-stalled event is emitted and self-healing may
                 ;; terminate and retry the phase on a fallback backend.
                 :agent/stream-gap-threshold-ms 90000
                 ;; Per-backend overrides for the gap threshold. Keys are backend
                 ;; keywords; values are millisecond integers. Empty by default.
                 ;; Example: {:opencode 210000} gives OpenCode 2 extra minutes
                 ;; (210s total) before stall detection fires.
                 :agent/per-backend-gap-thresholds {}}
  ;; Where agents run. :local (the default without this key) is a host
  ;; worktree with the operator's privileges; :governed is a container
  ;; capsule. With :require-governed? true, runs default to governed and a
  ;; run that would execute in another mode is refused.
  :execution {:require-governed? false}
  :governance {:readiness {}
               :risk {}
               :tiers {}
               :knowledge-safety {}}
  :policy-packs {:extra-search-paths []
                 :disabled-pack-ids []}
  :observability {:event-sinks [:file]
                  :log-sinks [:file]
                  :rotation {:max-size-mb 10
                             :retention-days 7}
                  :fleet {:url nil
                          :api-key nil
                          :batch-size 50
                          :flush-interval-ms 10000}}}}
